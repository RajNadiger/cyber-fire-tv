<?xml version="1.0" encoding="utf-8"?>
<!-- Inflated only by AppStudioActivity. No data schema. User asked for a settings page
     where they can change any app icon, name and colour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:orientation="horizontal"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="28dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@string/font_medium"
            android:text="@string/your_apps"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/your_apps_hint"
            android:textColor="#99EBEBF5"
            android:textSize="14sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/appList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="36dp">

        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="280dp"
            android:layout_height="158dp"
            android:background="@drawable/tile_bg">

            <ImageView
                android:id="@+id/stageArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <TextView
            android:id="@+id/stageName"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="@string/font_medium"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/stageCaption"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/your_apps_stage"
            android:textColor="#99EBEBF5"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/renameButton"
            style="@style/SettingsRow"
            android:layout_marginTop="16dp"
            android:text="@string/your_apps_rename" />

        <TextView
            android:id="@+id/pictureButton"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp"
            android:text="@string/your_apps_picture" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/colorRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/resetButton"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp"
            android:text="@string/your_apps_reset" />
    </LinearLayout>
</LinearLayout>
